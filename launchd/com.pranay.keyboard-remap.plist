<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pranay.keyboard-remap</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.local/bin/keyboard-remap-daemon</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/keyboard-remap.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/keyboard-remap.err</string>
</dict>
</plist>
